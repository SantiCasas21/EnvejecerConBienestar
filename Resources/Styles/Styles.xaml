<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- =============================================
         ESTILOS GLOBALES — ENVEJECER CON BIENESTAR
         Fuente mínima: 18sp | Botones mínimo: 56dp
         ============================================= -->

    <!-- Página base -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorFondo}" />
    </Style>

    <!-- ═══════════════ LABELS ═══════════════ -->

    <Style x:Key="LabelTitulo" TargetType="Label">
        <Setter Property="FontFamily" Value="NunitoBold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{StaticResource ColorTexto}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="LabelSubtitulo" TargetType="Label">
        <Setter Property="FontFamily" Value="NunitoSemiBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextoSecundario}" />
    </Style>

    <Style x:Key="LabelCuerpo" TargetType="Label">
        <Setter Property="FontFamily" Value="NunitoRegular" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{StaticResource ColorTexto}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="LabelPequeno" TargetType="Label">
        <Setter Property="FontFamily" Value="NunitoRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextoSecundario}" />
    </Style>

    <Style x:Key="LabelSeccion" TargetType="Label">
        <Setter Property="FontFamily" Value="NunitoSemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource ColorPrimario}" />
        <Setter Property="CharacterSpacing" Value="1" />
    </Style>

    <!-- ═══════════════ BOTONES ═══════════════ -->

    <!-- Botón primario -->
    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="FontFamily" Value="NunitoBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorPrimario}" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextoInverso}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="60" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource ColorPrimario}" Offset="0,4" Radius="12" Opacity="0.3" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón de emergencia rojo — grande y prominente -->
    <Style x:Key="BotonEmergencia" TargetType="Button">
        <Setter Property="FontFamily" Value="NunitoBold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorEmergencia}" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextoInverso}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HeightRequest" Value="72" />
        <Setter Property="Padding" Value="32,0" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource ColorEmergencia}" Offset="0,6" Radius="16" Opacity="0.4" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón secundario (contorno) -->
    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="FontFamily" Value="NunitoSemiBold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource ColorPrimario}" />
        <Setter Property="BorderColor" Value="{StaticResource ColorPrimario}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Padding" Value="24,0" />
    </Style>

    <!-- Botón "Tomado" verde para medicamentos -->
    <Style x:Key="BotonTomado" TargetType="Button">
        <Setter Property="FontFamily" Value="NunitoSemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorCompletado}" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextoInverso}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <!-- Botón "Tomado" estado completado -->
    <Style x:Key="BotonTomadoCompletado" TargetType="Button">
        <Setter Property="FontFamily" Value="NunitoSemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorCompletadoClaro}" />
        <Setter Property="TextColor" Value="{StaticResource ColorCompletado}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <!-- FAB (Botón flotante de acción) -->
    <Style x:Key="BotonFAB" TargetType="Button">
        <Setter Property="Text" Value="+" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorPrimario}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontFamily" Value="NunitoBold" />
        <Setter Property="WidthRequest" Value="64" />
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="CornerRadius" Value="32" />
    </Style>

    <!-- ═══════════════ TARJETAS / FRAMES ═══════════════ -->

    <!-- Tarjeta con sombra (original) -->
    <Style x:Key="TarjetaBase" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorFondoTarjeta}" />
        <Setter Property="BorderColor" Value="{StaticResource ColorBorde}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="HasShadow" Value="True" />
    </Style>

    <!-- Tarjeta blanca simple sin sombra (la más usada en la app) -->
    <Style x:Key="FrameTarjetaSimple" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorFondoTarjeta}" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="BorderColor" Value="{StaticResource ColorBorde}" />
    </Style>

    <!-- Contenedor de ícono sin padding ni sombra -->
    <Style x:Key="FrameIcono" TargetType="Frame">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <!-- Chip indicador de estado -->
    <Style x:Key="FrameStatusChip" TargetType="Frame">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <!-- Estado vacío -->
    <Style x:Key="FrameEmptyState" TargetType="Frame">
        <Setter Property="Padding" Value="30" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorFondoTarjeta}" />
        <Setter Property="BorderColor" Value="{StaticResource ColorBorde}" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <!-- Frame para Popups -->
    <Style x:Key="FramePopup" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorFondoTarjeta}" />
        <Setter Property="Padding" Value="25" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HasShadow" Value="True" />
    </Style>

    <!-- Tarjeta de medicamento -->
    <Style x:Key="TarjetaMedicamento" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorFondoTarjeta}" />
        <Setter Property="BorderColor" Value="{StaticResource ColorBorde}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="HasShadow" Value="True" />
    </Style>

    <!-- ═══════════════ ENTRYS ═══════════════ -->

    <Style x:Key="EntryForm" TargetType="Entry">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorFondo}" />
        <Setter Property="HeightRequest" Value="50" />
    </Style>

    <!-- ═══════════════ OTROS ═══════════════ -->

    <Style x:Key="ProgressBarDefault" TargetType="ProgressBar">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorFondoSecundario}" />
    </Style>

    <Style x:Key="Separador" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource ColorBorde}" />
    </Style>

</ResourceDictionary>
