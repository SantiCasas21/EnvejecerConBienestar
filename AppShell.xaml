<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EnvejecerConBienestar.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:EnvejecerConBienestar.Views"
    Shell.NavBarIsVisible="False"
    Shell.TabBarBackgroundColor="{DynamicResource ColorFondoTarjeta}"
    Shell.TabBarForegroundColor="{DynamicResource ColorPrimario}"
    Shell.TabBarUnselectedColor="{DynamicResource ColorTextoSecundario}"
    Shell.TabBarTitleColor="{DynamicResource ColorPrimario}">

    <!-- =============================================
         NAVEGACIÓN INFERIOR — 4 PESTAÑAS
         Iconos vectoriales Font Awesome 6 (FASolid)
         ============================================= -->

    <TabBar>

        <!-- 1. INICIO — fa-house -->
        <ShellContent
            Title="Inicio"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="home">
            <ShellContent.Icon>
                <FontImageSource Glyph="&#xf015;"
                                 FontFamily="FASolid"
                                 Size="24" />
            </ShellContent.Icon>
        </ShellContent>

        <!-- 2. MEDICAMENTOS — fa-capsules -->
        <ShellContent
            Title="Medicinas"
            ContentTemplate="{DataTemplate views:MedicamentosPage}"
            Route="medicamentos">
            <ShellContent.Icon>
                <FontImageSource Glyph="&#xf484;"
                                 FontFamily="FASolid"
                                 Size="24" />
            </ShellContent.Icon>
        </ShellContent>

        <!-- 3. JUEGOS — fa-puzzle-piece -->
        <ShellContent
            Title="Juegos"
            ContentTemplate="{DataTemplate views:JuegosPage}"
            Route="juegos">
            <ShellContent.Icon>
                <FontImageSource Glyph="&#xf12e;"
                                 FontFamily="FASolid"
                                 Size="24" />
            </ShellContent.Icon>
        </ShellContent>

        <!-- 4. CONTACTOS — fa-users -->
        <ShellContent
            Title="Contactos"
            ContentTemplate="{DataTemplate views:ContactosPage}"
            Route="contactos">
            <ShellContent.Icon>
                <FontImageSource Glyph="&#xf0c0;"
                                 FontFamily="FASolid"
                                 Size="24" />
            </ShellContent.Icon>
        </ShellContent>

        <!-- 5. PERFIL — fa-id-card -->
        <ShellContent
            Title="Perfil"
            ContentTemplate="{DataTemplate views:PerfilPage}"
            Route="perfil">
            <ShellContent.Icon>
                <FontImageSource Glyph="&#xf2c2;"
                                 FontFamily="FASolid"
                                 Size="24" />
            </ShellContent.Icon>
        </ShellContent>

    </TabBar>

</Shell>
