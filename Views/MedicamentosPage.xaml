<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EnvejecerConBienestar.Views.MedicamentosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EnvejecerConBienestar.ViewModels"
    xmlns:models="clr-namespace:EnvejecerConBienestar.Models"
    x:DataType="vm:MedicamentosViewModel"
    x:Name="thisPage"
    Title="Mis Medicamentos"
    BackgroundColor="{StaticResource ColorFondo}">

    <Grid RowDefinitions="Auto, *">
        <!-- Encabezado -->
        <VerticalStackLayout Padding="24,20" Spacing="8"
                             BackgroundColor="{StaticResource ColorFondoTarjeta}">
            <Label Text="Control de Medicinas"
                   FontFamily="NunitoBold" FontSize="26" TextColor="{StaticResource ColorTexto}" />
            <Label Text="No olvide tomar sus dosis a tiempo"
                   FontFamily="NunitoRegular" FontSize="16" TextColor="{StaticResource ColorTextoSecundario}" />

            <!-- Boton Generar Reporte -->
            <Button Text="Generar Reporte para mi Medico"
                    Command="{Binding GenerateReportCommand}"
                    BackgroundColor="{StaticResource ColorSecundario}"
                    TextColor="{StaticResource ColorTextoInverso}"
                    FontFamily="NunitoBold" FontSize="16"
                    HeightRequest="52" CornerRadius="14"
                    Margin="0,10,0,0"
                    HorizontalOptions="Fill" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" Command="{Binding LoadMedicamentosCommand}"
                     IsRefreshing="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout Padding="24,20" Spacing="24">

                    <!-- ═══ SUGERENCIAS RÁPIDAS ═══ -->
                    <VerticalStackLayout Spacing="12">
                        <Label Text="💡  Sugerencias Rapidas"
                               FontFamily="NunitoBold" FontSize="18" TextColor="{StaticResource ColorTexto}" />

                        <ScrollView Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="12">
                                <BindableLayout.ItemsSource>
                                    <Binding Path="Sugerencias" />
                                </BindableLayout.ItemsSource>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Medicamento">
                                        <!-- Chip de sugerencia -->
                                        <Frame Style="{StaticResource FrameTarjetaSimple}" Padding="0"
                                               CornerRadius="16" WidthRequest="140" HeightRequest="130">
                                            <VerticalStackLayout Padding="14,12"
                                                                 Spacing="8"
                                                                 HorizontalOptions="Center"
                                                                 VerticalOptions="Center">
                                                <!-- Icono -->
                                                <Frame Style="{StaticResource FrameIcono}"
                                                       BackgroundColor="{StaticResource ColorPrimarioClaro}" CornerRadius="14"
                                                       HeightRequest="44" WidthRequest="44">
                                                    <Label Text="{Binding Icono}" FontSize="22"
                                                           TextColor="{Binding ColorIcono}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Frame>
                                                <!-- Nombre -->
                                                <Label Text="{Binding Nombre}"
                                                       FontFamily="NunitoBold" FontSize="13"
                                                       TextColor="{StaticResource ColorTexto}"
                                                       HorizontalOptions="Center"
                                                       HorizontalTextAlignment="Center"
                                                       MaxLines="2" LineBreakMode="TailTruncation" />
                                                <!-- Dosis -->
                                                <Label Text="{Binding Miligramos, StringFormat='{0} mg'}"
                                                       FontSize="11" TextColor="{StaticResource ColorTextoSecundario}"
                                                       HorizontalOptions="Center" />
                                                <!-- Botón añadir -->
                                                <Button Text="＋ Añadir"
                                                        Clicked="OnAddSugerenciaClicked"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="{StaticResource ColorSecundarioClaro}"
                                                        TextColor="{StaticResource ColorPrimario}"
                                                        FontFamily="NunitoBold" FontSize="12"
                                                        HeightRequest="30" CornerRadius="10"
                                                        Padding="10,0" />
                                            </VerticalStackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!-- ═══ MIS MEDICAMENTOS ═══ -->
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Mis Medicamentos"
                                   FontFamily="NunitoBold" FontSize="18"
                                   TextColor="{StaticResource ColorTexto}" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding Medicamentos.Count, StringFormat='{0} medicinas'}"
                                   FontFamily="NunitoRegular" FontSize="14"
                                   TextColor="{StaticResource ColorTextoSecundario}" VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout Spacing="18"
                                             BindableLayout.ItemsSource="{Binding Medicamentos}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Medicamento">
                                    <!-- TARJETA DE MEDICAMENTO -->
                                    <Frame Style="{StaticResource TarjetaMedicamento}">
                                        <Frame.Triggers>
                                            <DataTrigger TargetType="Frame"
                                                         Binding="{Binding EstaTomado}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource ColorExitoClaro}" />
                                                <Setter Property="BorderColor" Value="{StaticResource ColorCompletado}" />
                                            </DataTrigger>
                                        </Frame.Triggers>

                                        <Grid ColumnDefinitions="Auto, *, Auto"
                                              RowDefinitions="Auto, Auto, Auto"
                                              ColumnSpacing="14" RowSpacing="5">

                                            <!-- Icono del medicamento -->
                                                <Frame Style="{StaticResource FrameIcono}"
                                                       BackgroundColor="{StaticResource ColorPrimarioClaro}" CornerRadius="16"
                                                       HeightRequest="56" WidthRequest="56"
                                                       VerticalOptions="Center">
                                                    <Label Text="{Binding Icono}" FontSize="30"
                                                           TextColor="{Binding ColorIcono}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Frame>

                                            <!-- Nombre y dosis -->
                                            <VerticalStackLayout Grid.Column="1" Grid.Row="0"
                                                                 VerticalOptions="End" Spacing="2">
                                                <Label Text="{Binding Nombre}"
                                                       FontFamily="NunitoBold" FontSize="19"
                                                       TextColor="{StaticResource ColorTexto}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding EstaTomado}" Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource ColorTexto}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </VerticalStackLayout>

                                            <!-- Dosis y frecuencia -->
                                            <Label Grid.Column="1" Grid.Row="1"
                                                   VerticalOptions="Start">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Miligramos, StringFormat='{0} mg'}"
                                                              FontSize="14" TextColor="{StaticResource ColorTextoSecundario}" />
                                                        <Span Text=" · Cada "
                                                              FontSize="14" TextColor="{StaticResource ColorTextoSecundario}" />
                                                        <Span Text="{Binding Frecuencia, StringFormat='{0} h'}"
                                                              FontSize="14" TextColor="{StaticResource ColorTextoSecundario}"
                                                              FontFamily="NunitoSemiBold" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <!-- Próxima alarma + Inventario -->
                                            <VerticalStackLayout Grid.Column="1" Grid.Row="2" Spacing="4">
                                                <Label>
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="🕐  Próxima: "
                                                                  FontSize="13" TextColor="{StaticResource ColorTextoSecundario}" />
                                                            <Span Text="{Binding HoraAlarma, StringFormat='{0:hh\\:mm}'}"
                                                                  FontSize="14"
                                                                  TextColor="{StaticResource ColorPrimario}"
                                                                  FontFamily="NunitoBold" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <!-- Alerta de inventario -->
                                                <Label Text="{Binding TextoInventario}"
                                                       FontFamily="NunitoSemiBold" FontSize="12"
                                                       TextColor="{Binding ColorInventario}" />
                                            </VerticalStackLayout>

                                            <!-- Indicador de estado + Botón -->
                                            <VerticalStackLayout Grid.Column="2" Grid.RowSpan="3"
                                                                 Spacing="6" VerticalOptions="Center"
                                                                 HorizontalOptions="Center">
                                                <!-- Indicador visual -->
                                                <Frame Style="{StaticResource FrameStatusChip}" Padding="6,3">
                                                    <Frame.Triggers>
                                                        <DataTrigger TargetType="Frame"
                                                                     Binding="{Binding EstaTomado}" Value="False">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource ColorPendiente}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Frame"
                                                                     Binding="{Binding EstaTomado}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource ColorCompletadoClaro}" />
                                                        </DataTrigger>
                                                    </Frame.Triggers>
                                                    <Label Text="{Binding IndicadorEstado}"
                                                           FontSize="12" />
                                                </Frame>

                                                <!-- Botón marcar -->
                                                <Button Text="{Binding TextoBoton}"
                                                        Clicked="OnToggleTomadoClicked"
                                                        CommandParameter="{Binding .}"
                                                        FontSize="13"
                                                        FontFamily="NunitoBold"
                                                        HeightRequest="42"
                                                        CornerRadius="12"
                                                        Padding="14,0">
                                                    <Button.Triggers>
                                                        <DataTrigger TargetType="Button"
                                                                     Binding="{Binding EstaTomado}" Value="False">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource ColorPrimario}" />
                                                            <Setter Property="TextColor" Value="White" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Button"
                                                                     Binding="{Binding EstaTomado}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource ColorCompletado}" />
                                                            <Setter Property="TextColor" Value="White" />
                                                            <Setter Property="Text" Value="✓ Tomado" />
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- Toque para ver detalle -->
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMedicamentoTapped" />
                                        </Frame.GestureRecognizers>
                                    </Frame>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                            <!-- Estado vacío -->
                            <BindableLayout.EmptyView>
                                <Frame Style="{StaticResource FrameEmptyState}">
                                    <VerticalStackLayout Spacing="12"
                                                         HorizontalOptions="Center">
                                        <Label Text="💊" FontSize="48"
                                               HorizontalOptions="Center" />
                                        <Label Text="No tiene medicinas registradas"
                                               FontFamily="NunitoBold" FontSize="18"
                                               TextColor="{StaticResource ColorTexto}"
                                               HorizontalOptions="Center" />
                                        <Label Text="Toque el botón ＋ para agregar su primer medicamento"
                                               FontSize="15" TextColor="{StaticResource ColorTextoSecundario}"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               MaximumWidthRequest="260"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Frame>
                            </BindableLayout.EmptyView>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- FAB para agregar medicamento -->
        <Button Grid.Row="1" Text="＋"
                Command="{Binding AddMedicamentoCommand}"
                Style="{StaticResource BotonFAB}"
                FontSize="34"
                WidthRequest="70" HeightRequest="70"
                CornerRadius="35"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="24" />
    </Grid>
</ContentPage>
