<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EnvejecerConBienestar.Views.MedicamentosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EnvejecerConBienestar.ViewModels"
    xmlns:models="clr-namespace:EnvejecerConBienestar.Models"
    x:DataType="vm:MedicamentosViewModel"
    x:Name="thisPage"
    Title="Mis Medicamentos">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <VerticalStackLayout Padding="20,15" BackgroundColor="{StaticResource ColorFondoTarjeta}">
            <Label Text="💊 Control de Medicinas" Style="{StaticResource LabelTitulo}" />
            <Label Text="No olvide tomar sus dosis a tiempo" Style="{StaticResource LabelSubtitulo}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" Command="{Binding LoadMedicamentosCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout Padding="20" Spacing="15">
                    
                    <!-- Sugerencias Rápidas -->
                    <Label Text="💡 Sugerencias Rápidas" FontFamily="NunitoBold" FontSize="16" Margin="0,5" />
                    <CollectionView ItemsSource="{Binding Sugerencias}" HeightRequest="150">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Medicamento">
                                <Frame WidthRequest="130" Padding="10" CornerRadius="15" BorderColor="#CBD5E1" BackgroundColor="White" HasShadow="False">
                                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                                        <Label Text="{Binding Icono}" FontSize="32" HorizontalOptions="Center" />
                                        <Label Text="{Binding Nombre}" FontSize="13" FontFamily="NunitoBold" HorizontalOptions="Center" HorizontalTextAlignment="Center" MaxLines="1" />
                                        <Button Text="Añadir" 
                                                Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.AddSugerenciaCommand}" 
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#E0F2FE"
                                                TextColor="{StaticResource ColorPrimario}"
                                                FontSize="11"
                                                Padding="5,0"
                                                HeightRequest="30"
                                                CornerRadius="10" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="📋 Mis Medicamentos" FontFamily="NunitoBold" FontSize="16" Margin="0,10,0,0" />
                    <CollectionView ItemsSource="{Binding Medicamentos}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Medicamento">
                                <Frame Style="{StaticResource TarjetaBase}" Margin="0,5" BorderColor="#CBD5E1">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.GoToDetailCommand}" CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                                        <Label Text="{Binding Icono}" FontSize="35" VerticalOptions="Center" />
                                        
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Nombre}" FontFamily="NunitoBold" FontSize="20" TextColor="#1E293B">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding EstaTomado}" Value="True">
                                                        <Setter Property="TextColor" Value="Gray" />
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Text="{Binding Miligramos, StringFormat='{0} mg'}" FontSize="15" TextColor="Gray" />
                                            <Label Text="{Binding HoraAlarma, StringFormat='⏰ Próxima: {0:hh\\:mm}'}" FontSize="15" FontFamily="NunitoSemiBold" TextColor="{StaticResource ColorPrimario}" />
                                        </VerticalStackLayout>

                                        <Button Grid.Column="2" 
                                                Text="{Binding TextoBoton}"
                                                Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.ToggleTomadoCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource ColorPrimario}"
                                                TextColor="White"
                                                FontSize="13" 
                                                Padding="10,0" 
                                                HeightRequest="45"
                                                CornerRadius="10">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding EstaTomado}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource ColorCompletado}" />
                                                    <Setter Property="Text" Value="✓" />
                                                    <Setter Property="WidthRequest" Value="45" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" Margin="0,60" Spacing="10">
                                <Label Text="💊" FontSize="50" HorizontalOptions="Center" />
                                <Label Text="No tiene medicinas registradas" Style="{StaticResource LabelSubtitulo}" HorizontalOptions="Center" />
                                <Label Text="Toque el botón + para agregar una" FontSize="14" HorizontalOptions="Center" TextColor="Gray" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- FAB -->
        <Button Grid.Row="1" Text="+" Command="{Binding AddMedicamentoCommand}"
                BackgroundColor="{StaticResource ColorPrimario}" TextColor="White"
                FontSize="35" WidthRequest="70" HeightRequest="70" CornerRadius="35"
                HorizontalOptions="End" VerticalOptions="End" Margin="25" />
    </Grid>
</ContentPage>
