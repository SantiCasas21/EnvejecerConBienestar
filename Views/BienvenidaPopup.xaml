<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
           x:Class="EnvejecerConBienestar.Views.BienvenidaPopup"
           Color="Transparent"
           CanBeDismissedByTappingOutsideOfPopup="False">

    <Frame BackgroundColor="{StaticResource ColorFondoTarjeta}"
           Padding="36,40" CornerRadius="30"
           HasShadow="True" WidthRequest="380">

        <VerticalStackLayout Spacing="28" HorizontalOptions="Center">

            <!-- ═══ NOMBRE DE LA APP ═══ -->
            <Label Text="Envejecer con Bienestar"
                   FontSize="32" FontFamily="NunitoBold"
                   TextColor="{StaticResource ColorPrimario}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <!-- ═══ MENSAJE CÁLIDO ═══ -->
            <Label Text="Tu compañero diario para una vida plena y saludable"
                   FontSize="16" FontFamily="NunitoRegular"
                   TextColor="{StaticResource ColorTextoSecundario}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"
                   MaximumWidthRequest="300" />

            <!-- ═══ EMOJI GRANDE EN CÍRCULO PASTEL ═══ -->
            <Frame Style="{StaticResource FrameIcono}"
                   BackgroundColor="{StaticResource ColorPrimarioClaro}"
                   CornerRadius="50" HeightRequest="100" WidthRequest="100"
                   HorizontalOptions="Center">
                <Label Text="🌿" FontSize="50"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>

            <!-- ═══ CAMPO DEL NOMBRE ═══ -->
            <VerticalStackLayout Spacing="12">
                <Label Text="Para personalizar tu experiencia, ¿cómo te gustaría que te llamemos?"
                       FontSize="17" FontFamily="NunitoSemiBold"
                       TextColor="{StaticResource ColorTexto}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       MaximumWidthRequest="300" />

                <Frame BackgroundColor="{StaticResource ColorFondo}"
                       CornerRadius="18" Padding="6,2" HasShadow="False"
                       BorderColor="{StaticResource ColorPrimarioClaro}">
                    <Entry x:Name="NombreEntry"
                           Placeholder="Escribe tu nombre aquí..."
                           FontSize="22"
                           FontFamily="NunitoRegular"
                           HorizontalOptions="Fill"
                           HeightRequest="64"
                           ClearButtonVisibility="WhileEditing"
                           ReturnType="Done"
                           Completed="OnNombreCompleted" />
                </Frame>
            </VerticalStackLayout>

            <!-- ═══ BOTÓN DE ACCIÓN ═══ -->
            <Button Text="¡Empecemos juntos! ✨"
                    Clicked="OnComenzarClicked"
                    BackgroundColor="{StaticResource ColorPrimario}"
                    TextColor="{StaticResource ColorTextoInverso}"
                    FontSize="22"
                    FontFamily="NunitoBold"
                    HeightRequest="68"
                    CornerRadius="20"
                    Margin="0,4,0,0" />

            <Label Text="Puedes cambiarlo después cuando quieras"
                   FontSize="13" FontFamily="NunitoRegular"
                   TextColor="{StaticResource ColorTextoSecundario}"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>
    </Frame>
</mct:Popup>
