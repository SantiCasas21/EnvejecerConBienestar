<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EnvejecerConBienestar.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EnvejecerConBienestar.ViewModels"
    xmlns:models="clr-namespace:EnvejecerConBienestar.Models"
    x:DataType="vm:HomeViewModel"
    x:Name="homePage"
    Title="Inicio">

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="25">
                
                <!-- Saludo -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding Saludo}" Style="{StaticResource LabelTitulo}" FontSize="32" />
                    <Label Text="¿Cómo se siente hoy?" Style="{StaticResource LabelSubtitulo}" />
                </VerticalStackLayout>

                <!-- BOTÓN SOS DESTACADO -->
                <Button Text="🚨 LLAMADA DE EMERGENCIA (SOS)" 
                        Command="{Binding LlamadaEmergenciaCommand}"
                        BackgroundColor="{StaticResource ColorEmergencia}"
                        TextColor="White"
                        FontFamily="NunitoBold"
                        FontSize="20"
                        HeightRequest="70"
                        CornerRadius="15"
                        Margin="0,10" />

                <!-- Widget de Hábitos (Carousel) -->
                <Frame Padding="0" HasShadow="True" CornerRadius="20" BorderColor="Transparent" BackgroundColor="{StaticResource ColorFondoTarjeta}">
                    <VerticalStackLayout Padding="0">
                        <Label Text="Tus Hábitos de Hoy" FontFamily="NunitoBold" Margin="20,15,20,5" FontSize="18" />
                        
                        <CarouselView ItemsSource="{Binding Habitos}" HeightRequest="220" PeekAreaInsets="30">
                            <CarouselView.ItemTemplate>
                                <DataTemplate x:DataType="models:Habito">
                                    <Frame Margin="10" Padding="15" BackgroundColor="White" BorderColor="#CBD5E1" CornerRadius="15" HasShadow="False">
                                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, *, Auto">
                                            <Label Text="{Binding Tipo}" FontSize="18" FontFamily="NunitoBold" TextColor="{StaticResource ColorPrimario}" />
                                            
                                            <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                                <Label Text="{Binding ProgresoActual, StringFormat='{0}'}" FontSize="40" FontFamily="NunitoBold" HorizontalOptions="Center" TextColor="#1E293B" />
                                                <Label Text="{Binding Meta, StringFormat='meta: {0}'}" Style="{StaticResource LabelPequeno}" HorizontalOptions="Center" />
                                            </VerticalStackLayout>

                                            <ProgressBar Grid.Row="2" Progress="{Binding Porcentaje}" ProgressColor="{StaticResource ColorPrimario}" HeightRequest="12" />
                                            
                                            <Button Grid.Column="1" Grid.RowSpan="3" 
                                                    Text="+" 
                                                    Command="{Binding BindingContext.ActualizarProgresoCommand, Source={x:Reference homePage}}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource ColorPrimario}"
                                                    TextColor="White"
                                                    FontSize="28"
                                                    WidthRequest="60" HeightRequest="60" CornerRadius="30" />
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>

                        <IndicatorView HorizontalOptions="Center" Margin="0,0,0,10" IndicatorColor="Silver" SelectedIndicatorColor="{StaticResource ColorPrimario}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Sección de Ayuda Rápida (Limpia) -->
                <Label Text="Panel de Control" FontFamily="NunitoBold" FontSize="18" />
                
                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                    <Frame Grid.Column="0" BackgroundColor="#DBEAFE" CornerRadius="15" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVerMedicamentosClicked" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="5">
                            <Label Text="💊" FontSize="30" HorizontalOptions="Center" />
                            <Label Text="Medicina" FontFamily="NunitoBold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="1" BackgroundColor="#F3E8FF" CornerRadius="15" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVerContactosClicked" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="5">
                            <Label Text="👥" FontSize="30" HorizontalOptions="Center" />
                            <Label Text="Contactos" FontFamily="NunitoBold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
