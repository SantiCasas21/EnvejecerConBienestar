<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EnvejecerConBienestar.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EnvejecerConBienestar.ViewModels"
    xmlns:models="clr-namespace:EnvejecerConBienestar.Models"
    xmlns:helpers="clr-namespace:EnvejecerConBienestar.Helpers"
    x:DataType="vm:HomeViewModel"
    x:Name="homePage"
    Title="Inicio"
    BackgroundColor="{StaticResource ColorFondo}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadDataCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="24,50,24,30" Spacing="28">

                <!-- ═══════════ ENCABEZADO: SALUDO ═══════════ -->
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                    <Frame Grid.Column="0" Style="{StaticResource FrameIcono}"
                           BackgroundColor="{StaticResource ColorFondoTarjeta}" CornerRadius="24"
                           HeightRequest="56" WidthRequest="56"
                           VerticalOptions="Center">
                        <Label Text="{Binding EmojiSaludo}" FontFamily="FASolid" FontSize="28"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding Saludo}" FontFamily="NunitoBold" FontSize="26"
                               TextColor="{StaticResource ColorTexto}" LineBreakMode="TailTruncation" />
                        <Label Text="¿Cómo se siente hoy?" FontFamily="NunitoRegular" FontSize="16"
                               TextColor="{StaticResource ColorTextoSecundario}" />
                    </VerticalStackLayout>
                </Grid>

                <!-- ═══════════ BOTÓN SOS ═══════════ -->
                <Button Text="🚨  LLAMADA DE EMERGENCIA (SOS)"
                        Command="{Binding LlamadaEmergenciaCommand}"
                        BackgroundColor="{StaticResource ColorEmergencia}"
                        TextColor="{StaticResource ColorTextoInverso}"
                        FontFamily="NunitoBold"
                        FontSize="22"
                        HeightRequest="72"
                        CornerRadius="18" />

                <!-- ═══════════ MIS MEDICINAS DE HOY ═══════════ -->
                <VerticalStackLayout Spacing="14">

                    <!-- Encabezado de sección -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Mis Medicinas de Hoy"
                               FontFamily="NunitoBold" FontSize="22"
                               TextColor="{StaticResource ColorTexto}" VerticalOptions="Center" />
                        <Frame Grid.Column="1" BackgroundColor="{StaticResource ColorPendiente}" CornerRadius="10"
                               Padding="10,4" HasShadow="False" HorizontalOptions="End"
                               IsVisible="{Binding HayPendientes}">
                            <Label Text="Pendiente" FontFamily="NunitoSemiBold"
                                   FontSize="13" TextColor="{StaticResource ColorEmergencia}" />
                        </Frame>
                    </Grid>

                    <!-- Estado: Sin medicamentos registrados -->
                    <Frame Style="{StaticResource FrameTarjetaSimple}" CornerRadius="18" Padding="20"
                           IsVisible="{Binding HayMedicamentos, Converter={StaticResource InverseBoolConverter}}">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="&#x1F48A;" FontSize="36" HorizontalOptions="Center" TextColor="{StaticResource ColorTextoSecundario}" />
                            <Label Text="No tiene medicinas registradas"
                                   FontFamily="NunitoSemiBold" FontSize="16"
                                   TextColor="{StaticResource ColorTextoSecundario}" HorizontalOptions="Center" />
                            <Label Text="Vaya a la sección Medicinas para agregar sus dosis diarias."
                                   FontSize="14" TextColor="{StaticResource ColorTextoSecundario}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                   MaximumWidthRequest="260" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- PRÓXIMA MEDICINA (destacada) -->
                    <Frame Style="{StaticResource FrameTarjetaSimple}" CornerRadius="22" Padding="22"
                           BorderColor="{StaticResource ColorPrimario}" IsVisible="{Binding HayProxima}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16"
                              RowDefinitions="Auto, Auto, Auto" RowSpacing="8">

                            <!-- Icono grande -->
                                        <Frame Style="{StaticResource FrameIcono}"
                                               BackgroundColor="{StaticResource ColorPrimarioClaro}" CornerRadius="20"
                                               HeightRequest="76" WidthRequest="76"
                                               VerticalOptions="Center">
                                            <Label Text="{Binding ProximaMedicina.Icono}" FontSize="40"
                                                   TextColor="{Binding ProximaMedicina.ColorIcono}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Frame>

                            <!-- Etiqueta "PRÓXIMA" -->
                            <Label Grid.Column="1" Grid.Row="0"
                                   Text="PRÓXIMA TOMA"
                                   Style="{StaticResource LabelSeccion}" />

                            <!-- Nombre y dosis -->
                            <VerticalStackLayout Grid.Column="1" Grid.Row="1" Spacing="2">
                                <Label Text="{Binding ProximaMedicina.Nombre}"
                                       FontFamily="NunitoBold" FontSize="22"
                                       TextColor="{StaticResource ColorTexto}" />
                                <Label FontSize="15" TextColor="{StaticResource ColorTextoSecundario}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding ProximaMedicina.Miligramos, StringFormat='{0} mg'}"
                                                  FontFamily="NunitoSemiBold" />
                                            <Span Text=" · Cada " />
                                            <Span Text="{Binding ProximaMedicina.Frecuencia, StringFormat='{0} h'}"
                                                  FontFamily="NunitoSemiBold" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>

                            <!-- Hora + botón -->
                            <Grid Grid.Column="1" Grid.Row="2" ColumnDefinitions="Auto, *" ColumnSpacing="14">
                                <Frame BackgroundColor="{StaticResource ColorPrimarioClaro}" CornerRadius="12"
                                       Padding="12,6" HasShadow="False">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="&#xf017;" FontFamily="FASolid" FontSize="16" VerticalOptions="Center" />
                                        <Label Text="{Binding ProximaEtiqueta}"
                                               FontFamily="NunitoBold" FontSize="16"
                                               TextColor="{StaticResource ColorPrimario}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Frame>
                                <Button Grid.Column="1" Text="✓  Marcar como tomada"
                                        Clicked="OnMarcarProximaTomada"
                                        BackgroundColor="{StaticResource ColorCompletado}"
                                        TextColor="{StaticResource ColorTextoInverso}"
                                        FontFamily="NunitoBold" FontSize="16"
                                        HeightRequest="50" CornerRadius="14"
                                        Padding="16,0" />
                            </Grid>
                        </Grid>
                    </Frame>

                    <!-- Estado: Todo tomado -->
                    <Frame Style="{StaticResource FrameTarjetaSimple}" CornerRadius="18" Padding="20"
                           IsVisible="{Binding TodasTomadas}"
                           BackgroundColor="{StaticResource ColorExitoClaro}" BorderColor="{StaticResource ColorCompletado}">
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label Text="&#x1F3C6;" FontSize="24" VerticalOptions="Center" />
                            <Label Text="¡Todas las medicinas fueron tomadas hoy!"
                                   FontFamily="NunitoSemiBold" FontSize="17"
                                   TextColor="{StaticResource ColorTexto}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Frame>

                    <!-- Lista de otras pendientes -->
                    <VerticalStackLayout Spacing="10"
                                         BindableLayout.ItemsSource="{Binding MedicinasPendientes}"
                                         IsVisible="{Binding HayPendientes}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Medicamento">
                                <Frame Style="{StaticResource FrameTarjetaSimple}" CornerRadius="16" Padding="16">
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                                        <!-- Icono pequeño -->
                                        <Frame Style="{StaticResource FrameIcono}"
                                               BackgroundColor="{StaticResource ColorPrimarioClaro}" CornerRadius="14"
                                               HeightRequest="50" WidthRequest="50"
                                               VerticalOptions="Center">
                                            <Label Text="{Binding Icono}" FontSize="26"
                                                   TextColor="{Binding ColorIcono}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Frame>

                                        <!-- Nombre y hora -->
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Nombre}"
                                                   FontFamily="NunitoBold" FontSize="17"
                                                   TextColor="{StaticResource ColorTexto}" />
                                            <Label FontSize="14" TextColor="{StaticResource ColorTextoSecundario}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Miligramos, StringFormat='{0} mg'}" />
                                                        <Span Text=" · Cada " />
                                                        <Span Text="{Binding Frecuencia, StringFormat='{0} h'}"
                                                              FontFamily="NunitoSemiBold" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>

                                        <!-- Botón marcar tomada -->
                                        <Button Grid.Column="2" Text="✓"
                                                Clicked="OnMarcarPendienteTomada"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource ColorPrimario}"
                                                TextColor="{StaticResource ColorTextoInverso}"
                                                FontFamily="NunitoBold" FontSize="18"
                                                WidthRequest="50" HeightRequest="50"
                                                CornerRadius="25"
                                                Padding="0"
                                                VerticalOptions="Center" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ═══════════ LOGROS DEL DÍA (METAS) ═══════════ -->
                <VerticalStackLayout Spacing="14">

                    <!-- Encabezado con resumen -->
                    <Frame Style="{StaticResource FrameTarjetaSimple}" Padding="16" CornerRadius="18">
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="Logros del Dia"
                                   FontFamily="NunitoBold" FontSize="20" TextColor="{StaticResource ColorTexto}"
                                   VerticalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding ResumenDiario}"
                                   FontFamily="NunitoSemiBold" FontSize="14" TextColor="{StaticResource ColorTextoSecundario}"
                                   VerticalOptions="Center" />
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                         Style="{StaticResource ProgressBarDefault}"
                                         Progress="{Binding PorcentajeDiario}"
                                         ProgressColor="{StaticResource ColorPrimario}"
                                         HeightRequest="10" />
                        </Grid>
                    </Frame>

                    <!-- Tarjetas de metas -->
                    <VerticalStackLayout Spacing="12"
                                         BindableLayout.ItemsSource="{Binding Metas}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Meta">
                                <Frame Style="{StaticResource FrameTarjetaSimple}" Padding="20" CornerRadius="20">
                                    <Frame.Triggers>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Completada}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource ColorExitoClaro}" />
                                            <Setter Property="BorderColor" Value="{StaticResource ColorCompletado}" />
                                        </DataTrigger>
                                    </Frame.Triggers>

                                    <Grid ColumnDefinitions="Auto, *, Auto"
                                          RowDefinitions="Auto, Auto, Auto"
                                          ColumnSpacing="16" RowSpacing="6">

                                        <!-- Icono de la meta -->
                                        <Frame Grid.RowSpan="3" Style="{StaticResource FrameIcono}"
                                               BackgroundColor="{StaticResource ColorSecundarioClaro}" CornerRadius="18"
                                               HeightRequest="64" WidthRequest="64"
                                               VerticalOptions="Center">
                                            <Label Text="{Binding Icono}" FontSize="34"
                                                   TextColor="{Binding ColorIcono}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Frame>

                                        <!-- Nombre -->
                                        <Label Grid.Column="1" Grid.Row="0"
                                               Text="{Binding Nombre}"
                                               FontFamily="NunitoBold" FontSize="20"
                                               TextColor="{StaticResource ColorTexto}" VerticalOptions="End" />

                                        <!-- Progreso -->
                                        <Label Grid.Column="1" Grid.Row="1"
                                               Text="{Binding TextoProgreso}"
                                               FontFamily="NunitoRegular" FontSize="15"
                                               TextColor="{StaticResource ColorTextoSecundario}" VerticalOptions="Start" />

                                        <!-- Barra de progreso -->
                                        <ProgressBar Grid.Column="1" Grid.Row="2"
                                                     Style="{StaticResource ProgressBarDefault}"
                                                     Progress="{Binding Porcentaje}"
                                                     ProgressColor="{StaticResource ColorPrimario}"
                                                     HeightRequest="12" />

                                        <!-- Botón + grande -->
                                        <Button Grid.Column="2" Grid.RowSpan="3"
                                                Text="+"
                                                Clicked="OnIncrementarClicked"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource ColorPrimario}"
                                                TextColor="{StaticResource ColorTextoInverso}"
                                                FontSize="32"
                                                FontFamily="NunitoBold"
                                                WidthRequest="68" HeightRequest="68"
                                                CornerRadius="34"
                                                Padding="0"
                                                VerticalOptions="Center">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button"
                                                             Binding="{Binding Completada}" Value="True">
                                                    <Setter Property="Text" Value="✓" />
                                                    <Setter Property="BackgroundColor" Value="{StaticResource ColorCompletado}" />
                                                    <Setter Property="FontSize" Value="28" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                        <!-- Estado vacío -->
                        <BindableLayout.EmptyView>
                            <Frame Style="{StaticResource FrameEmptyState}">
                                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                                    <Label Text="&#x1F3AF;" FontSize="48" HorizontalOptions="Center" TextColor="{StaticResource ColorTextoSecundario}" />
                                    <Label Text="Sin metas para hoy"
                                           FontFamily="NunitoBold" FontSize="19"
                                           TextColor="{StaticResource ColorTexto}" HorizontalOptions="Center" />
                                    <Label Text="Toca el botón de abajo para crear tu primera meta y empezar a cuidarte."
                                           FontSize="15" TextColor="{StaticResource ColorTextoSecundario}"
                                           HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                           MaximumWidthRequest="260" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Frame>
                        </BindableLayout.EmptyView>
                    </VerticalStackLayout>

                    <!-- Botón Nueva Meta -->
                    <Button Text="＋  Nueva Meta"
                            Clicked="OnAddMetaClicked"
                            BackgroundColor="{StaticResource ColorPrimario}"
                            TextColor="{StaticResource ColorTextoInverso}"
                            FontFamily="NunitoBold" FontSize="20"
                            HeightRequest="64" CornerRadius="18"
                            Margin="0,4,0,0" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
