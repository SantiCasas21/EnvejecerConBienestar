<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EnvejecerConBienestar.Views.JuegosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EnvejecerConBienestar.ViewModels"
    xmlns:models="clr-namespace:EnvejecerConBienestar.Models"
    x:DataType="vm:JuegosViewModel"
    x:Name="juegosPage"
    Title="Juegos">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Header -->
        <VerticalStackLayout Padding="20" Spacing="5">
            <Label Text="Agilidad Mental" Style="{StaticResource LabelTitulo}" />
            <Label Text="Encuentre las parejas de números" Style="{StaticResource LabelSubtitulo}" />
        </VerticalStackLayout>

        <!-- Stats -->
        <Frame Grid.Row="1" Margin="20,0,20,10" Padding="15" Style="{StaticResource TarjetaBase}">
            <Grid ColumnDefinitions="*, *">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label Text="Intentos" Style="{StaticResource LabelPequeno}" HorizontalOptions="Center" />
                    <Label Text="{Binding Intentos}" Style="{StaticResource LabelTitulo}" FontSize="24" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="Tiempo" Style="{StaticResource LabelPequeno}" HorizontalOptions="Center" />
                    <Label Text="{Binding TiempoTranscurrido}" Style="{StaticResource LabelTitulo}" FontSize="24" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- Game Board -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="20" Spacing="20">
                <CollectionView ItemsSource="{Binding Fichas}" 
                                HorizontalOptions="Center">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="15" VerticalItemSpacing="15" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:JuegoFicha">
                            <Frame HeightRequest="100" 
                                   WidthRequest="100" 
                                   Padding="0" 
                                   CornerRadius="15"
                                   BackgroundColor="{Binding ColorFondo}"
                                   HasShadow="True">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.VoltearFichaCommand, Source={x:Reference juegosPage}}" 
                                                          CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Grid>
                                    <!-- Back of card -->
                                    <Label Text="?" 
                                           FontSize="40" 
                                           FontFamily="NunitoBold" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center" 
                                           TextColor="#94A3B8"
                                           IsVisible="{Binding EstaVolteada, Converter={StaticResource InverseBoolConverter}}" />
                                    
                                    <!-- Front of card -->
                                    <Label Text="{Binding Valor}" 
                                           FontSize="45" 
                                           FontFamily="NunitoBold" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center" 
                                           TextColor="{StaticResource ColorPrimario}"
                                           IsVisible="{Binding EstaVolteada}" />

                                    <!-- Matched Overlay -->
                                    <BoxView BackgroundColor="#80FFFFFF" IsVisible="{Binding EstaEmparejada}" />
                                    <Label Text="✔️" FontSize="30" HorizontalOptions="End" VerticalOptions="Start" Margin="5" IsVisible="{Binding EstaEmparejada}" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="Reiniciar Juego" 
                        Style="{StaticResource BotonSecundario}" 
                        Command="{Binding IniciarJuegoCommand}" 
                        HorizontalOptions="Center" 
                        WidthRequest="200" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
