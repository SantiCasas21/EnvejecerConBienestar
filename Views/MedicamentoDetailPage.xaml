<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EnvejecerConBienestar.Views.MedicamentoDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EnvejecerConBienestar.ViewModels"
    xmlns:helpers="clr-namespace:EnvejecerConBienestar.Helpers"
    x:DataType="vm:MedicamentoDetailViewModel"
    Title="Detalle de Medicamento"
    BackgroundColor="{StaticResource ColorFondo}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">
        <!-- Barra superior -->
        <Grid BackgroundColor="{StaticResource ColorFondoTarjeta}" Padding="20,12" ColumnDefinitions="Auto, *, Auto"
              ColumnSpacing="14">
            <Button Text="← Volver"
                    Command="{Binding BackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource ColorTextoSecundario}"
                    FontFamily="NunitoSemiBold" FontSize="16"
                    BorderColor="Transparent"
                    HeightRequest="44" Padding="8,0" />

            <Label Grid.Column="1" Text="Detalles"
                   FontFamily="NunitoBold" FontSize="19" TextColor="{StaticResource ColorTexto}"
                   VerticalOptions="Center" HorizontalOptions="Center" />

            <Button Grid.Column="2"
                    Command="{Binding ToggleEditCommand}"
                    BackgroundColor="Transparent"
                    WidthRequest="48" HeightRequest="44"
                    BorderColor="Transparent"
                    FontSize="20">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsEditing}" Value="False">
                        <Setter Property="Text" Value="✏️" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding IsEditing}" Value="True">
                        <Setter Property="Text" Value="✕" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,20" Spacing="22">

                <!-- ═══ ICONO Y ESTADO ═══ -->
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Frame Style="{StaticResource FrameIcono}" HeightRequest="90" WidthRequest="90"
                           CornerRadius="45" HorizontalOptions="Center"
                           BackgroundColor="{StaticResource ColorPrimarioClaro}">
                        <Label Text="{Binding Medicamento.Icono}" FontSize="44"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                    <!-- Indicador de estado -->
                    <Frame Style="{StaticResource FrameStatusChip}" Padding="10,4" CornerRadius="12">
                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame"
                                         Binding="{Binding Medicamento.EstaTomado}" Value="False">
                                <Setter Property="BackgroundColor" Value="{StaticResource ColorPendiente}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Frame"
                                         Binding="{Binding Medicamento.EstaTomado}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource ColorCompletadoClaro}" />
                            </DataTrigger>
                        </Frame.Triggers>
                        <Label FontSize="14" FontFamily="NunitoSemiBold" HorizontalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding Medicamento.EstaTomado}" Value="False">
                                    <Setter Property="Text" Value="🔴 Pendiente" />
                                    <Setter Property="TextColor" Value="{StaticResource ColorEmergencia}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding Medicamento.EstaTomado}" Value="True">
                                    <Setter Property="Text" Value="🟢 Tomado hoy" />
                                    <Setter Property="TextColor" Value="{StaticResource ColorCompletado}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Frame>
                </VerticalStackLayout>

                <!-- ═══ DATOS DEL MEDICAMENTO ═══ -->
                <!-- Nombre -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="NOMBRE" Style="{StaticResource LabelSeccion}" />
                    <Label Text="{Binding Medicamento.Nombre}" FontFamily="NunitoBold"
                           FontSize="24" TextColor="{StaticResource ColorTexto}"
                           IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}" />
                    <Entry Text="{Binding Medicamento.Nombre}"
                           Placeholder="Nombre del medicamento"
                           IsVisible="{Binding IsEditing}"
                           FontSize="20" BackgroundColor="{StaticResource ColorFondo}"
                           HeightRequest="54" />
                </VerticalStackLayout>

                <!-- Dosis -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="DOSIS" Style="{StaticResource LabelSeccion}" />
                    <Label Text="{Binding Medicamento.Miligramos, StringFormat='{0} miligramos'}"
                           FontFamily="NunitoRegular" FontSize="20" TextColor="{StaticResource ColorTexto}"
                           IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}" />
                    <Entry Text="{Binding Medicamento.Miligramos}"
                           Placeholder="Ej. 500"
                           Keyboard="Numeric"
                           IsVisible="{Binding IsEditing}"
                           FontSize="20" BackgroundColor="{StaticResource ColorFondo}"
                           HeightRequest="54" />
                </VerticalStackLayout>

                <!-- Frecuencia -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="FRECUENCIA" Style="{StaticResource LabelSeccion}" />
                    <Label Text="{Binding Medicamento.Frecuencia, StringFormat='Cada {0} horas'}"
                           FontFamily="NunitoRegular" FontSize="20" TextColor="{StaticResource ColorTexto}"
                           IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}" />
                    <Entry Text="{Binding Medicamento.Frecuencia}"
                           Placeholder="Cada cuántas horas (ej. 8)"
                           Keyboard="Numeric"
                           IsVisible="{Binding IsEditing}"
                           FontSize="20" BackgroundColor="{StaticResource ColorFondo}"
                           HeightRequest="54" />
                </VerticalStackLayout>

                <!-- Hora de alarma -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="HORA DE INICIO" Style="{StaticResource LabelSeccion}" />
                    <Label Text="{Binding Medicamento.HoraAlarma, StringFormat='{0:hh\\:mm}'}"
                           FontFamily="NunitoBold" FontSize="26" TextColor="{StaticResource ColorPrimario}"
                           IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}" />
                    <TimePicker Time="{Binding Medicamento.HoraAlarma}"
                                IsVisible="{Binding IsEditing}"
                                FontSize="20" HorizontalOptions="Start"
                                HeightRequest="54" />
                </VerticalStackLayout>

                <!-- ═══ HORARIO DE TOMAS CALCULADO ═══ -->
                <Frame Style="{StaticResource FrameTarjetaSimple}" Padding="20" CornerRadius="18"
                       IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Text="🕐" FontSize="22" VerticalOptions="Start" Margin="0,2,0,0" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" Margin="10,0,0,0">
                                <Label Text="Horario de tomas hoy"
                                       FontFamily="NunitoBold" FontSize="17"
                                       TextColor="{StaticResource ColorTexto}" />
                                <Label FontSize="14" TextColor="{StaticResource ColorTextoSecundario}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Cada " />
                                            <Span Text="{Binding Medicamento.Frecuencia, StringFormat='{0} horas'}"
                                                  FontFamily="NunitoBold" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding Medicamento.TomasPorDia, StringFormat='{0} tomas'}"
                                                  FontFamily="NunitoBold" />
                                            <Span Text=" al día" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView Style="{StaticResource Separador}" Margin="0,4" />

                        <!-- Lista de horas -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Medicamento.TextoHorario}"
                                   FontFamily="NunitoRegular" FontSize="17"
                                   TextColor="{StaticResource ColorTextoSecundario}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Notas -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="NOTAS" Style="{StaticResource LabelSeccion}" />
                    <Label Text="{Binding Medicamento.Notas}"
                           FontFamily="NunitoRegular" FontSize="18" TextColor="{StaticResource ColorTextoSecundario}"
                           IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}" />
                    <Editor Text="{Binding Medicamento.Notas}"
                            Placeholder="Notas adicionales..."
                            AutoSize="TextChanges"
                            IsVisible="{Binding IsEditing}"
                            FontSize="18" BackgroundColor="{StaticResource ColorFondo}"
                            MinimumHeightRequest="80" />
                </VerticalStackLayout>

                <!-- ═══ BOTONES DE ACCIÓN ═══ -->
                <VerticalStackLayout Spacing="14" Margin="0,10,0,30">
                    <Button Text="💾  Guardar Cambios"
                            Command="{Binding SaveCommand}"
                            IsVisible="{Binding IsEditing}"
                            BackgroundColor="{StaticResource ColorCompletado}"
                            TextColor="{StaticResource ColorTextoInverso}"
                            FontFamily="NunitoBold" FontSize="20"
                            HeightRequest="62" CornerRadius="16" />

                    <Button Text="🗑️  Eliminar Medicina"
                            Command="{Binding DeleteCommand}"
                            IsVisible="{Binding IsEditing}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource ColorEmergencia}" BorderColor="{StaticResource ColorEmergencia}"
                            FontFamily="NunitoSemiBold" FontSize="18"
                            HeightRequest="56" CornerRadius="16"
                            BorderWidth="2" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
