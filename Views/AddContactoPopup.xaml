<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
           x:Class="EnvejecerConBienestar.Views.AddContactoPopup"
           Color="Transparent">

    <Frame BackgroundColor="White" Padding="25" CornerRadius="20" WidthRequest="340" HasShadow="True">
        <VerticalStackLayout Spacing="15">
            <Label Text="Nuevo Contacto" FontSize="24" FontFamily="NunitoBold" HorizontalOptions="Center" TextColor="{StaticResource ColorPrimario}" />
            
            <Entry x:Name="NombreEntry" Placeholder="Nombre completo" FontSize="18" HeightRequest="50" />
            <Entry x:Name="TelefonoEntry" Placeholder="Teléfono" Keyboard="Telephone" FontSize="18" HeightRequest="50" />
            <Entry x:Name="UbicacionEntry" Placeholder="Ubicación (Opcional)" FontSize="18" HeightRequest="50" />

            <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="Favorito" FontSize="12" HorizontalOptions="Center" />
                    <CheckBox x:Name="FavoritoCheck" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="Es SOS" FontSize="12" HorizontalOptions="Center" />
                    <CheckBox x:Name="EmergenciaCheck" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,0">
                <Button Text="Cancelar" Clicked="OnCancelClicked" Style="{StaticResource BotonSecundario}" Grid.Column="0" />
                <Button Text="Guardar" Clicked="OnSaveClicked" Style="{StaticResource BotonPrimario}" Grid.Column="1" BackgroundColor="{StaticResource ColorCompletado}" />
            </Grid>
        </VerticalStackLayout>
    </Frame>
</mct:Popup>
