<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EnvejecerConBienestar.Views.ContactosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EnvejecerConBienestar.ViewModels"
    xmlns:models="clr-namespace:EnvejecerConBienestar.Models"
    xmlns:helpers="clr-namespace:EnvejecerConBienestar.Helpers"
    x:DataType="vm:ContactosViewModel"
    x:Name="thisPage"
    Title="Agenda de Contactos">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
            <helpers:IntToBoolConverter x:Key="IntToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">
        <VerticalStackLayout Padding="20,15" BackgroundColor="{StaticResource ColorFondoTarjeta}">
            <Label Text="Mis Contactos" Style="{StaticResource LabelTitulo}" />
            <Label Text="Personas importantes y de confianza" Style="{StaticResource LabelSubtitulo}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" Command="{Binding LoadDataCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout Padding="20" Spacing="25">
                    
                    <!-- SOS -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding Emergencias.Count, Converter={StaticResource IntToBoolConverter}}">
                        <Label Text="🚨 EMERGENCIAS" FontFamily="NunitoBold" TextColor="{StaticResource ColorEmergencia}" />
                        <CollectionView ItemsSource="{Binding Emergencias}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Contacto">
                                    <Frame Style="{StaticResource TarjetaBase}" Margin="0,5">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnContactoTapped" />
                                        </Frame.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <Label Text="{Binding Icono}" FontSize="24" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Nombre}" Style="{StaticResource LabelCuerpo}" Margin="15,0" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="📞" FontSize="20" VerticalOptions="Center" />
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- FAVORITOS -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="⭐ FAVORITOS" FontFamily="NunitoBold" TextColor="{StaticResource ColorPrimario}" />
                        <CollectionView ItemsSource="{Binding Favoritos}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Contacto">
                                    <Frame Style="{StaticResource TarjetaBase}" Margin="0,5">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnContactoTapped" />
                                        </Frame.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <Label Text="{Binding Icono}" FontSize="24" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Nombre}" Style="{StaticResource LabelCuerpo}" Margin="15,0" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="▶️" FontSize="18" VerticalOptions="Center" TextColor="Gray" />
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- OTROS -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="👥 TODOS LOS CONTACTOS" FontFamily="NunitoBold" TextColor="Gray" />
                        <CollectionView ItemsSource="{Binding Otros}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Contacto">
                                    <Frame Style="{StaticResource TarjetaBase}" Margin="0,5" Padding="12">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnContactoTapped" />
                                        </Frame.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <Label Text="{Binding Icono}" FontSize="24" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Nombre}" Style="{StaticResource LabelCuerpo}" Margin="15,0" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="▶️" FontSize="18" VerticalOptions="Center" TextColor="Silver" />
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- FAB -->
        <Button Grid.Row="1" Text="+" Command="{Binding AddNewCommand}"
                Style="{StaticResource BotonFAB}"
                HorizontalOptions="End" VerticalOptions="End" Margin="25" />
    </Grid>
</ContentPage>
